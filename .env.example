# llm-orchestrator - environment template
#
# Copy for local development:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, and never put secrets in
# this template.
#
# Providers never read the environment themselves: the (future) configuration
# layer reads these variables and passes the values explicitly, e.g.
# `GeminiProvider(api_key=os.environ["GEMINI_API_KEY"])`.

# Gemini (Phase 4). Required only for the opt-in live Gemini integration test:
#     RUN_GEMINI_INTEGRATION=1 GEMINI_API_KEY=... GEMINI_TEST_MODEL=... pytest -m live
GEMINI_API_KEY=
GEMINI_TEST_MODEL=

# Groq (Phase 5). Required only for the opt-in live Groq integration test:
#     RUN_GROQ_INTEGRATION=1 GROQ_API_KEY=... GROQ_TEST_MODEL=... pytest -m live
GROQ_API_KEY=
GROQ_TEST_MODEL=
