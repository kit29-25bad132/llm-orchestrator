# llm-orchestrator - environment template
#
# Copy for local development:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, and never put secrets in
# this template.
#
# Providers never read the environment themselves: the configuration layer
# (`llm_orchestrator.config`) reads these variables and passes the values
# explicitly, e.g. `GeminiProvider(api_key=...)` via `build_registry()`.
# The library never loads `.env` automatically (no `python-dotenv`
# dependency): load it in your own process (e.g. `export $(cat .env)` or
# your editor's env support) before calling `load_settings()`.

# Gemini (Phase 4). Required only for the opt-in live Gemini integration test:
#     RUN_GEMINI_INTEGRATION=1 GEMINI_API_KEY=... GEMINI_TEST_MODEL=... pytest -m live
GEMINI_API_KEY=
GEMINI_TEST_MODEL=

# Groq (Phase 5). Required only for the opt-in live Groq integration test:
#     RUN_GROQ_INTEGRATION=1 GROQ_API_KEY=... GROQ_TEST_MODEL=... pytest -m live
GROQ_API_KEY=
GROQ_TEST_MODEL=

# Library default (Phase 12, optional). Lowest-priority timeout in seconds:
# per-call `timeout_s` > `LLMRequest.timeout_s` > provider
# `default_timeout_s` > this value > SDK default. Leave blank for no
# library-level default.
LLM_ORCH_DEFAULT_TIMEOUT_S=
